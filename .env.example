# AUTOVÉRTICE - variables de entorno
# Copia este archivo como `.env` y completa los valores. NUNCA subas `.env` al repositorio.

# -----------------------------------------------------------------------------
# MODO DE DATOS
# -----------------------------------------------------------------------------
# demo  -> usa el catálogo de demostración incluido en la aplicación (sin backend).
# supabase -> usa un proyecto Supabase real (requiere las variables siguientes).
VITE_DATA_MODE=demo

# -----------------------------------------------------------------------------
# SUPABASE (opcional - necesario cuando VITE_DATA_MODE=supabase)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Las operaciones sensibles (publicar anuncios, administrar catálogo, login de
# administradores) deben ejecutarse con Service Role en el servidor. Esa clave
# NUNCA va en el frontend ni en variables VITE_*.

# -----------------------------------------------------------------------------
# CONTACTO COMERCIAL POR DEFECTO (opcional)
# -----------------------------------------------------------------------------
# Teléfono del vendedor/plataforma en formato internacional, sin signos.
# Si está vacío, la aplicación no mostrará un botón de WhatsApp inventado:
# pedirá configurar el número o usará el formulario de contacto.
VITE_DEFAULT_WHATSAPP=

# -----------------------------------------------------------------------------
# IMÁGENES (opcional)
# -----------------------------------------------------------------------------
# Prefijo para URLs remotas de imágenes (por ejemplo un bucket de Supabase Storage).
VITE_IMAGE_BASE_URL=
